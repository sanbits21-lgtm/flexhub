MONGODB_URI=mongodb://localhost:27017/flexhub
JWT_SECRET=change_me_to_a_long_random_string
PORT=5000

# Sign-in sessions. Every API call carries a short-lived ACCESS token; a longer-lived REFRESH
# token (an httpOnly cookie on the website, the secure store in the mobile app) renews it. A
# stolen access token is useless after minutes; a refresh token is replaced on every use, and
# an old one coming back signs that whole login out. All optional; these are the defaults:
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30           signed out after this many days without opening the app
# REFRESH_MAX_DAYS=180            even an active login must sign in again after this long
# REFRESH_GRACE_SECONDS=20        a just-replaced refresh token is still accepted this long (lost replies, two tabs)

# Wrong-password lockout, per account (a made-up email or member code locks the same way, so a
# lock reveals nothing about who has an account). The right password is refused while locked.
# Each lock after the first lasts longer, up to 4x. All optional; these are the defaults:
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15         failures older than this stop counting
# LOGIN_LOCK_MINUTES=15

# Content-Security-Policy: the browser refuses scripts and requests the site itself does not use.
# enforce (default) | report-only (log what it WOULD block, block nothing) | off.
# Violations are logged by the server as "[csp] blocked ...". If a new feature loads something
# from another site, switch to report-only, see what it reports, and add it in backend/middleware/csp.js.
# CSP_MODE=enforce

# Production only. NODE_ENV=production also enables serving frontend/dist as static files.
# CORS_ORIGIN: comma-separated allowed origins (e.g. https://app.example.com). Leave unset
# for a single-service deploy (backend serves the built frontend, same origin, no CORS
# needed) — only set this if the frontend is hosted on a different domain than the API.
NODE_ENV=development
CORS_ORIGIN=

# Optional: creates the first super-admin at startup if that email does not exist (no shell needed).
# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=at-least-12-characters
# Used only by backend/scripts/seedSuperAdmin.js
SEED_EMAIL=super@example.com
SEED_PASSWORD=ChangeMe@123
SEED_NAME=Super Admin
SEED_PHONE=0000000000

# Member app: AI workout/diet suggestions. Unset = built-in rule-based plans (no external call).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Where member profile photos are stored (default backend/uploads). Use a persistent volume in production.
UPLOAD_DIR=

# --- Docker / production -------------------------------------------------------------
# JWT_SECRET must be 32+ random chars or the container refuses to start:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# APP_PORT=8080            host port for the app
# DOMAIN=gym.example.com   only for `--profile proxy` (Caddy HTTPS)
# Shown on the public /privacy page (required by the app stores):
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# --- Gym subdomains (iron.yourdomain.com) --------------------------------------------
# BASE_DOMAIN switches the feature on: the app then reads the gym from the address.
# Leave empty to run on a single address with no subdomains.
BASE_DOMAIN=
# For HTTPS on every subdomain with the bundled Caddy:
# CADDYFILE=Caddyfile.wildcard
# CLOUDFLARE_API_TOKEN=   (token with "Edit zone DNS" for your domain)

# --- Self-registration, free trial, email -----------------------------------------------
# Anyone can register a gym at /signup; they must confirm their email, then a platform admin
# approves them. Trial terms are edited in the website (Platform Settings). These are only the
# starting defaults, used until a super-admin saves the settings page:
SELF_SIGNUP=on
TRIAL_DAYS=14
TRIAL_MAX_MEMBERS=50
TRIAL_MAX_BRANCHES=1
# Registrations allowed per network address per hour:
SIGNUP_PER_HOUR=5
# Gym owners are emailed a week before, the day before, and when their trial or plan ends
# (checked every 6 hours; platform staff get one summary). A paid plan keeps working for 3 more
# days after it ends, then the gym goes read-only until you press Renew on the Tenants page.
# Set to off to stop the emails (the lock still applies):
# EXPIRY_NOTICES=off

# Outgoing email (confirmation links, approval notices). EASIEST: Brevo's web API, one key, works on
# hosts that block SMTP ports (create it at Brevo > SMTP & API > API Keys; it starts with xkeysib-):
#   BREVO_API_KEY=xkeysib-...
# Or any SMTP provider (used only when BREVO_API_KEY is empty):
#   SMTP_URL=smtps://user:password@smtp.example.com:465
# or SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_SECURE=true
# In production sign-up stays closed until one of these is set. In development, mail is
# printed to the server log. Check it any time: Platform Settings > Email (super-admin).
# MAIL_TIMEOUT_SECONDS=10   how long to wait for the mail service before giving up
BREVO_API_KEY=
SMTP_URL=
MAIL_FROM=FlexHub <no-reply@yourdomain.com>
# Public address used in email links, e.g. https://yourdomain.com
PUBLIC_URL=

# --- Running it for real clients (see docs/OPERATIONS.md) -------------------------------
# Who is emailed when the server fails (comma-separated). Empty = the super-admins. Production only unless ALERTS=on.
# ALERT_EMAIL=you@example.com
# REQUIRE_LOCAL_DB=on        outside production, refuse to start against a hosted (Atlas) database
# Named in the public Terms of Service page (/terms). Have the text reviewed by a lawyer.
# TERMS_OPERATOR_NAME=Your Company Pvt Ltd
# TERMS_GOVERNING_LAW=India
# TERMS_REQUIRED=off         only to switch off the "I agree" box at sign-up

# --- Hosting ---------------------------------------------------------------------------
# Number of proxies in front of the app (1 on Render and with the bundled Caddy).
TRUST_PROXY=1
