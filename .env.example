MONGODB_URI=mongodb://localhost:27017/flexhub
JWT_SECRET=change_me_to_a_long_random_string
PORT=5000

# Production only. NODE_ENV=production also enables serving frontend/dist as static files.
# CORS_ORIGIN: comma-separated allowed origins (e.g. https://app.example.com). Leave unset
# for a single-service deploy (backend serves the built frontend, same origin, no CORS
# needed) — only set this if the frontend is hosted on a different domain than the API.
NODE_ENV=development
CORS_ORIGIN=

# Optional: creates the first super-admin at startup if that email does not exist (no shell needed).
# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=at-least-12-characters
# Used only by backend/scripts/seedSuperAdmin.js
SEED_EMAIL=super@example.com
SEED_PASSWORD=ChangeMe@123
SEED_NAME=Super Admin
SEED_PHONE=0000000000

# Member app: AI workout/diet suggestions. Unset = built-in rule-based plans (no external call).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Where member profile photos are stored (default backend/uploads). Use a persistent volume in production.
UPLOAD_DIR=

# --- Docker / production -------------------------------------------------------------
# JWT_SECRET must be 32+ random chars or the container refuses to start:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# APP_PORT=8080            host port for the app
# DOMAIN=gym.example.com   only for `--profile proxy` (Caddy HTTPS)
# Shown on the public /privacy page (required by the app stores):
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# --- Gym subdomains (iron.yourdomain.com) --------------------------------------------
# BASE_DOMAIN switches the feature on: the app then reads the gym from the address.
# Leave empty to run on a single address with no subdomains.
BASE_DOMAIN=
# For HTTPS on every subdomain with the bundled Caddy:
# CADDYFILE=Caddyfile.wildcard
# CLOUDFLARE_API_TOKEN=   (token with "Edit zone DNS" for your domain)

# --- Self-registration, free trial, email -----------------------------------------------
# Anyone can register a gym at /signup; they must confirm their email, then a platform admin
# approves them. Trial terms are edited in the website (Platform Settings). These are only the
# starting defaults, used until a super-admin saves the settings page:
SELF_SIGNUP=on
TRIAL_DAYS=14
TRIAL_MAX_MEMBERS=50
TRIAL_MAX_BRANCHES=1
# Registrations allowed per network address per hour:
SIGNUP_PER_HOUR=5
# Gym owners are emailed a week before, the day before, and when their trial or plan ends
# (checked every 6 hours; platform staff get one summary). A paid plan keeps working for 3 more
# days after it ends, then the gym goes read-only until you press Renew on the Tenants page.
# Set to off to stop the emails (the lock still applies):
# EXPIRY_NOTICES=off

# Outgoing email (confirmation links, approval notices). Any SMTP provider:
#   SMTP_URL=smtps://user:password@smtp.example.com:465
# or SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_SECURE=true
# In production sign-up stays closed until one of these is set. In development, mail is
# printed to the server log.
SMTP_URL=
MAIL_FROM=FlexHub <no-reply@yourdomain.com>
# Public address used in email links, e.g. https://yourdomain.com
PUBLIC_URL=

# --- Hosting ---------------------------------------------------------------------------
# Number of proxies in front of the app (1 on Render and with the bundled Caddy).
TRUST_PROXY=1
