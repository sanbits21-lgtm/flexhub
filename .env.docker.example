# Settings for the one-server Docker stack (docker-compose.yml). Copy this file to .env.docker and fill it in:
#   cp .env.docker.example .env.docker
# Never commit .env.docker (it is git-ignored): it holds your passwords. Full guide: docs/VPS.md
#
# Run every command with:  docker compose --env-file .env.docker ...
# (The flag matters: it keeps this stack apart from any other .env file in the folder.)

# ---- Your address ----------------------------------------------------------------------------------------------------------
# The domain you point at the server, with no https:// and no www.   e.g. fitzyclub.in
DOMAIN=fitzyclub.in
# The main address people open, with https://. Used in every email link. Required.
PUBLIC_URL=https://fitzyclub.in
# Set to the same domain to give every gym its own address (iron.fitzyclub.in). Needs a wildcard DNS record (docs/VPS.md).
# Leave empty to run on the single address only.
BASE_DOMAIN=fitzyclub.in
# Let's Encrypt writes here if a certificate is about to expire. Use a real address you read.
ACME_EMAIL=you@example.com

# ---- Which database ---------------------------------------------------------------------------------------------------------
# Option A (default): a database on this same server, in Docker. Nothing else to set except the two passwords below.
COMPOSE_PROFILES=localdb
# Option B: MongoDB Atlas. Delete the line above (leave COMPOSE_PROFILES empty), and paste your Atlas connection string here.
# Letters in the password must be URL-encoded, and Atlas must allow this server's IP (docs/VPS.md, "Using MongoDB Atlas instead").
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fitzyclub?retryWrites=true&w=majority
DATABASE_URL=

# ---- Secrets: make each one long and random --------------------------------------------------------------------------------
# Letters and numbers only (no symbols), so they can sit inside a database address without escaping. Make them with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# or, with no Node:   openssl rand -hex 24
# (the two MONGO_ passwords are only used by option A)
MONGO_ROOT_PASSWORD=change-me-long-random-letters-and-numbers
MONGO_APP_PASSWORD=change-me-another-long-random-one
# Signs every login. 32+ characters; the app refuses to start with a short or placeholder value.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-at-least-32-random-characters-xxxxxxxxxxxx

# ---- Your first sign-in -----------------------------------------------------------------------------------------------------
# The platform owner is created at start-up if it does not exist yet. After you have signed in and changed the password,
# DELETE SUPER_ADMIN_PASSWORD from this file and restart.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PHONE=

# ---- Email (sign-up confirmation, password resets, expiry notices) -----------------------------------------------------------
# Without email, new gyms cannot register in production. Use the SMTP login your provider (Brevo, etc.) gives you.
SMTP_URL=
MAIL_FROM=FitzyClub <no-reply@fitzyclub.in>
ALERT_EMAIL=

# ---- Backups ----------------------------------------------------------------------------------------------------------------
# A backup of the database and the member photos every day at this hour (server time), kept for this many days.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# Where the files go on the server (a normal folder). Copy it OFF the server as well: docs/VPS.md.
BACKUP_DIR=./backups
TZ=Asia/Kolkata

# ---- Shown on the public Terms and Privacy pages (have a lawyer review them first) -------------------------------------------
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
TERMS_OPERATOR_NAME=
TERMS_GOVERNING_LAW=India

# ---- Optional ---------------------------------------------------------------------------------------------------------------
# Error tracking: paste a Sentry project key to turn it on (docs/OPERATIONS.md).
SENTRY_DSN=
# Where your members open the app, if it is not the main address.
MEMBER_APP_URL=
# AI workout and diet suggestions. Without it the built-in rule-based plans are used.
ANTHROPIC_API_KEY=

# ---- Sizing (defaults suit a 2 GB server and up) ------------------------------------------------------------------------------
MONGO_CACHE_GB=0.5
MONGO_MEM_LIMIT=1g
APP_MEM_LIMIT=768m

# ---- Testing on your own computer: change ONLY these (see docs/VPS.md, "Try it on your computer") ----------------------------
# On a real server leave them as they are.
HTTP_PORT=80
HTTPS_PORT=443
CADDY_LOCAL_CERTS=
